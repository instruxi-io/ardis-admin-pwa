# Enforcer V2 API base URL (no trailing slash).
# STAGING, to match VITE_ARDIS_MS_URL below. This previously named the
# production gateway, so a local build authenticated against production while
# writing schemas to staging ardis-ms.
VITE_ENFORCER_BASE_URL=https://gateway-staging.instruxi.dev/api/v1/enforcer

# ardis-ms base URL (no trailing slash)
VITE_ARDIS_MS_URL=https://ardis-ms-ix.fly.dev/api/v1/ardis

# Environment label shown in portal header (optional)
VITE_APP_ENV=development
